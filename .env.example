# Copie para .env (arquivo .env está no .gitignore — NÃO commitar segredos)

# Obrigatório em produção
JWT_SECRET=troque-por-um-segredo-longo-aleatorio

# Opcional — Spring AI (sem chave usa RAG local da cartilha)
OPENAI_API_KEY=

# RabbitMQ (docker compose padrão)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=floodshield
RABBITMQ_PASS=floodshield
RABBITMQ_LISTENER_ENABLED=false
RABBITMQ_HEALTH_ENABLED=false

# Perfil prod (PostgreSQL / Azure SQL via JDBC)
# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/floodshield
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
